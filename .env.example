# Copy to .env.local and fill in. .env*.local is gitignored and must stay that way.
#
# Only one variable is needed, and even that has a default in the code, so a
# fresh clone runs with no .env.local at all.

# The roster Edge Function.
VITE_ROSTER_API_URL=https://kfqaaehcjqzfqxhmtskg.supabase.co/functions/v1/roster

# ─── Optional ───────────────────────────────────────────────────────────────
# The shared Supabase project. src/lib/supabase.js already defaults to the
# right values, so set these only to point the site at a different project —
# a staging one, say. An environment variable always wins over the default.
#
# Both are safe in the browser: the anon key is designed to ship in client code
# and grants nothing on its own. Who may read or change the roster is decided
# by row level security and by the signed-in account's role, which the Edge
# Function checks.
#
# Never put the service_role key here. Anything VITE_* is compiled into the
# public JavaScript, and service_role bypasses row level security entirely.
#
# VITE_SUPABASE_URL=https://<your-project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<the anon / publishable key, not service_role>
