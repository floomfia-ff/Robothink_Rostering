# Copy to .env.local and fill in. .env*.local is gitignored and must stay that way.

# The roster Edge Function.
VITE_ROSTER_API_URL=https://kfqaaehcjqzfqxhmtskg.supabase.co/functions/v1/roster

# The shared Supabase project — the SAME two values the feedback site uses, so
# copy them from that project's .env.local. They sign you in; the roster
# function then checks you are an admin.
#
# Both are safe in the browser. The anon key is designed to be public and
# grants nothing on its own — who may read or change the roster is decided by
# the signed-in account's role.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<the anon key from Supabase → Project Settings → API>

# ─── On its way out ─────────────────────────────────────────────────────────
# The old shared door code. It is still sent, and still accepted, ONLY until
# the updated supabase/functions/roster/index.ts is deployed — that way the
# site and the function can be updated in either order without a gap where the
# roster stops working.
#
# Once that function is deployed:
#   1. delete this line here and from .env.local
#   2. delete CODE from src/lib/api.js
#   3. delete the ROSTER_CODE secret in Supabase → Edge Functions → Secrets
#
# It was never a secret — Vite compiles anything VITE_* into the public
# JavaScript, so every visitor had it. That is the whole reason for this change.
VITE_ROSTER_CODE=ask-matin
